[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (16, 16)
    width = 360
    height = (0, 160)
    notification_limit = 4

    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ignore_newline = no
    show_indicators = no
    icon_position = off

    frame_width = 2
    frame_color = "#7aa2f7"
    corner_radius = 6
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    separator_height = 0

    idle_threshold = 120
    show_age_threshold = 60
    sort = yes
    stack_duplicates = yes

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#101014"
    foreground = "#d8d8dc"
    frame_color = "#44475a"
    timeout = 5

[urgency_normal]
    background = "#101014"
    foreground = "#d8d8dc"
    frame_color = "#7aa2f7"
    timeout = 8

[urgency_critical]
    background = "#101014"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
