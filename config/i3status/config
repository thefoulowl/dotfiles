general {
        colors = true
        interval = 5
        color_good = "#7aa2f7"
        color_degraded = "#e0af68"
        color_bad = "#f7768e"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "memory"
order += "volume master"
order += "tztime local"

wireless _first_ {
        format_up = " %essid"
        format_down = " down"
}

ethernet _first_ {
        format_up = " %ip"
        format_down = ""
}

battery all {
        format = "%status %percentage"
        format_down = ""
        status_chr = ""
        status_bat = ""
        status_full = ""
        low_threshold = 15
}

memory {
        format = " %used"
        threshold_degraded = "1G"
        format_degraded = " %available"
}

tztime local {
        format = " %Y-%m-%d  %H:%M"
}

volume master {
        format = " %volume"
        format_muted = " muted"
        device = "pulse"
}
