#!/bin/bash
# goforit — connect/disconnect Bluetooth audio devices, with EQ profiles.
#   goforit [dev]          toggle (connect if disconnected, disconnect if connected)
#   goforit [dev] on|off   connect / disconnect
#   goforit [dev] status   show state
#   goforit [dev] movie    connect + Movie EQ (dialogue clarity, tamed mud/harshness)
#   goforit [dev] music    connect + Music EQ (fuller bass, sparkle)
#   goforit [dev] flat     EQ off
#   goforit [dev] boost    re-apply current EQ (or flat) with +12 dB gain for quiet sources
# dev: buds (default, realme Buds Air 7) | zeb (Zebronics Zeb County 8)
# Connecting one device disconnects the other.
declare -A DEV_MAC=( [buds]="18:5C:A1:18:97:FB" [zeb]="2D:7F:76:4A:8C:32" )
declare -A DEV_NAME=( [buds]="realme Buds Air7" [zeb]="Zeb County 8" )
declare -A DEV_PROFILE=( [zeb]="a2dp-sink-sbc_xq" )   # best codec the speaker offers
declare -A DEV_ICON=( [buds]="" [zeb]="󰓃" )

DEV=buds
case "$1" in buds|zeb) DEV=$1; shift ;; esac
MAC=${DEV_MAC[$DEV]}
NAME=${DEV_NAME[$DEV]}
ICON=${DEV_ICON[$DEV]}
SINK="bluez_output.${MAC//:/_}.1"
EQDIR="$HOME/.config/pipewire/eq"
RUN="${XDG_RUNTIME_DIR:-/tmp}/goforit"

connected() { bluetoothctl info "$MAC" 2>/dev/null | grep -q "Connected: yes"; }
notify() { command -v dunstify >/dev/null && dunstify -a osd -u low -r 9993 "$1" "$2"; echo "$1 $2"; }

do_on() {
  bluetoothctl power on >/dev/null
  eq_off quiet
  for d in "${!DEV_MAC[@]}"; do   # one output at a time
    [[ $d != "$DEV" ]] && bluetoothctl info "${DEV_MAC[$d]}" 2>/dev/null | grep -q "Connected: yes" \
      && bluetoothctl disconnect "${DEV_MAC[$d]}" >/dev/null 2>&1
  done
  echo "Connecting to $NAME..."
  for i in 1 2 3; do
    timeout 12 bluetoothctl connect "$MAC" >/dev/null 2>&1 && break
    sleep 2
  done
  if connected; then
    for i in $(seq 1 10); do pactl list sinks short 2>/dev/null | grep -q "$SINK" && break; sleep 0.5; done
    [[ -n ${DEV_PROFILE[$DEV]} ]] && pactl set-card-profile "bluez_card.${MAC//:/_}" "${DEV_PROFILE[$DEV]}" 2>/dev/null
    pactl set-default-sink "$SINK" 2>/dev/null
    codec=$(pactl list sinks 2>/dev/null | grep -A60 "$SINK" | grep -oP 'api.bluez5.codec = "\K[^"]+')
    notify "$ICON $NAME" "connected${codec:+ · ${codec^^}}"
  else
    notify "$ICON $NAME" "not found — is it on and in range?"; exit 1
  fi
}

do_off() {
  eq_off quiet
  bluetoothctl disconnect "$MAC" >/dev/null 2>&1
  notify "$ICON $NAME" "disconnected"
}

# --- EQ: a PipeWire filter-chain process creating a virtual sink that feeds the buds ---
vol_of() { pactl get-sink-volume "$1" 2>/dev/null | grep -oP '\d+(?=%)' | head -1; }

eq_off() {
  if [[ -f "$RUN/eq.profile" ]]; then
    # hand the user's level back to the buds sink so the volume keys keep meaning the same thing
    local v; v=$(vol_of "eq_$(cat "$RUN/eq.profile")"); [[ -n $v ]] && pactl set-sink-volume "$SINK" "${v}%"
  fi
  [[ -f "$RUN/eq.pid" ]] && kill "$(cat "$RUN/eq.pid")" 2>/dev/null
  rm -f "$RUN/eq.pid" "$RUN/eq.profile" "$RUN/eq.boost"
  pactl set-default-sink "$SINK" 2>/dev/null
  [[ $1 == quiet ]] || notify "󰓃 EQ" "off (flat)"
}

eq_on() {
  local prof=$1
  [[ -f "$EQDIR/$DEV-$prof.conf" ]] && prof="$DEV-$prof"   # device-specific curve if present
  local conf="$EQDIR/$prof.conf"
  [[ -f "$conf" ]] || { echo "no EQ profile '$prof' (have: $(ls "$EQDIR" | sed 's/.conf//' | tr '\n' ' '))"; exit 1; }
  connected || do_on || exit 1
  local v; v=$(vol_of "$SINK")
  eq_off quiet
  mkdir -p "$RUN"
  sed "s|@TARGET@|$SINK|" "$conf" > "$RUN/eq.conf"
  if [[ -n $BOOST ]]; then   # inject a +12 dB mixer stage at the head of the chain
    local first; first=$(grep -oP 'name = \K\w+(?=\s+control)' "$conf" | head -1)
    sed -i "/nodes = \[/a\          { type = builtin label = mixer name = boost control = { \"Gain 1\" = 4.0 } }" "$RUN/eq.conf"
    sed -i "/links = \[/a\          { output = \"boost:Out\" input = \"$first:In\" }" "$RUN/eq.conf"
    local last; last=$(grep -oP 'name = \K\w+(?=\s+control)' "$conf" | tail -1)
    sed -i "/filter.graph = {/a\        inputs = [ \"boost:In 1\" ]\n        outputs = [ \"$last:Out\" ]" "$RUN/eq.conf"
    echo boost > "$RUN/eq.boost"
  else
    rm -f "$RUN/eq.boost"
  fi
  pipewire -c "$RUN/eq.conf" >/dev/null 2>&1 &
  echo $! > "$RUN/eq.pid"; echo "$prof" > "$RUN/eq.profile"
  for i in $(seq 1 20); do pactl list sinks short 2>/dev/null | grep -q "eq_$prof" && break; sleep 0.25; done
  # volume lives on the EQ sink; the buds sink stays at 100% so the two don't stack
  pactl set-sink-volume "eq_$prof" "${v:-70}%" 2>/dev/null
  pactl set-sink-volume "$SINK" 100% 2>/dev/null
  pactl set-default-sink "eq_$prof" 2>/dev/null && notify "󰓃 EQ" "${prof^} on${BOOST:+ · +12 dB boost}" || notify "󰓃 EQ" "failed to start"
}

case "${1:-toggle}" in
  on)     do_on ;;
  off)    do_off ;;
  status) connected && echo "$NAME: connected" || echo "$NAME: disconnected"
          [[ -f "$RUN/eq.profile" ]] && echo "EQ: $(cat "$RUN/eq.profile")$( [[ -f $RUN/eq.boost ]] && echo ' +12 dB')" || echo "EQ: flat" ;;
  movie|music) eq_on "$1" ;;
  boost)  cur=$(cat "$RUN/eq.profile" 2>/dev/null); cur=${cur#$DEV-}; BOOST=1 eq_on "${cur:-flat}" ;;
  flat)   eq_off ;;   # note: "flat" EQ profile file is only used as the boost base
  toggle) connected && do_off || do_on ;;
  *)      sed -n '2,10p' "$0"; exit 1 ;;
esac
